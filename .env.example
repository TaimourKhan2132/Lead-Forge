# Copy to .env and fill in. .env is gitignored. Never commit real values.

# Identity used to fill {{NAME}}, {{EMAIL}}, {{LINKEDIN}}, {{GITHUB}} in packs and drafts.
LEADFORGE_NAME=
LEADFORGE_EMAIL=
LEADFORGE_LINKEDIN=
LEADFORGE_GITHUB=

# Discovery engine: auto | docker | playwright
# auto uses gosom/google-maps-scraper via Docker when Docker is running,
# otherwise the built-in Playwright engine.
LEADFORGE_ENGINE=auto

# Browser channel for the Playwright engine: msedge | chrome
LEADFORGE_BROWSER=msedge

# gosom/google-maps-scraper telemetry opt-out (passed into the container).
DISABLE_TELEMETRY=1

# Phase 9 only (unattended scoring). Leave empty until then.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
